# ВНИМАНИЕ: это ШАБЛОН. Никогда не коммить реальные ключи!
# Скопируй в .env (он в .gitignore) и подставь свои значения.

# Supabase (фронтенд) — публичные значения, безопасно отдавать в браузер
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# VAPID публичный ключ (фронтенд) — он публичный по дизайну
VITE_VAPID_PUBLIC_KEY=BJ... (твой VAPID public key)

# VAPID (бэкенд — задавать ТОЛЬКО в Netlify/Supabase secrets, НЕ в коде и НЕ в git!)
VAPID_PUBLIC_KEY=BJ... (твой VAPID public key)
VAPID_PRIVATE_KEY=... (СЕКРЕТ! только в env переменных хостинга)
VAPID_SUBJECT=mailto:your@email.com

# Supabase (бэкенд — service_role ключ, СЕКРЕТ, только в Netlify/Supabase secrets!)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ... (service_role key из Supabase Settings -> API)
