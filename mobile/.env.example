# Скопируй в .env и подставь значения (те же, что VITE_* в веб-версии).
# EXPO_PUBLIC_* попадают в сборку — сюда только публичные значения.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Адрес веб-версии (как window.location.origin в вебе): ссылки-приглашения
# ?invite=КОД и возврат после оплаты ЮKassa
EXPO_PUBLIC_WEB_URL=https://love-app.netlify.app
