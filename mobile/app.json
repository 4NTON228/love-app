{
  "expo": {
    "name": "Love App",
    "slug": "love-app",
    "version": "1.0.0",
    "scheme": "loveapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#160A10",
    "ios": {
      "bundleIdentifier": "app.love.couple",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Чтобы прикреплять фото к сообщениям и моментам.",
        "NSCameraUsageDescription": "Чтобы снимать фото и видеокружки для партнёра.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.love.couple",
      "adaptiveIcon": {
        "backgroundColor": "#160A10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Face ID не используется приложением."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#160A10"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы прикреплять фото к сообщениям и моментам.",
          "cameraPermission": "Чтобы снимать фото и видеокружки для партнёра."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A62B41"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Чтобы записывать голосовые сообщения и видеокружки."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Чтобы снимать фото и видеокружки для партнёра.",
          "microphonePermission": "Чтобы записывать голосовые сообщения и видеокружки.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
